#!/bin/sh
# runit service: vigila /etc/dwl/config.h y corre dwl-rebuild cuando
# detecta que el archivo se guardó (evento CLOSE_WRITE o MOVED_TO,
# para cubrir editores que guardan con archivo temporal + rename).
exec 2>&1
mkdir -p /etc/dwl
touch /etc/dwl/config.h

echo "dwl-config-watch: vigilando /etc/dwl/config.h"
exec inotifywait -m -e close_write -e moved_to --format '%f' /etc/dwl/ 2>/dev/null | \
while read -r file; do
    if [ "$file" = "config.h" ]; then
        echo "dwl-config-watch: cambio detectado, reconstruyendo..."
        /usr/sbin/dwl-rebuild || echo "dwl-config-watch: rebuild falló, ver /tmp/dwl-rebuild.log"
    fi
done
