#!/bin/sh
set -e

case "$1" in
    configure)
        # Si el usuario no tiene ya un /etc/dwl/config.h propio, lo
        # sembramos con el config.def.h de upstream (comportamiento
        # por defecto). Nunca pisamos un config.h existente.
        if [ ! -s /etc/dwl/config.h ]; then
            cp /usr/share/dwl-devuan/config.def.h /etc/dwl/config.h
            echo "dwl-devuan: creado /etc/dwl/config.h (default). Editalo y" \
                 "corré 'dwl-rebuild', o dejá que dwl-config-watch lo haga solo."
        fi

        # Habilitar el servicio runit si el sistema usa runit con el
        # layout típico de Devuan (/etc/runit/runsvdir/default).
        if [ -d /etc/runit/runsvdir/default ] && [ -d /etc/sv/dwl-config-watch ]; then
            if [ ! -e /etc/runit/runsvdir/default/dwl-config-watch ]; then
                ln -s /etc/sv/dwl-config-watch /etc/runit/runsvdir/default/dwl-config-watch
                echo "dwl-devuan: servicio dwl-config-watch habilitado (runit)."
                echo "dwl-devuan: se activará solo, o corré 'sv up dwl-config-watch' ya mismo."
            fi
        else
            echo "dwl-devuan: no encontré el runsvdir default de runit;" \
                 "habilitá el servicio a mano si querés el watch automático:"
            echo "  ln -s /etc/sv/dwl-config-watch /etc/runit/runsvdir/default/"
        fi
        ;;
esac

#DEBHELPER#

exit 0
