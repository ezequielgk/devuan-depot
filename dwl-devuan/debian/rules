#!/usr/bin/make -f

# No compilamos dwl "de una" contra config.h fijo: el binario que se
# empaqueta en el .deb usa config.def.h (comportamiento por defecto).
# La personalización real ocurre DESPUÉS de instalar, vía dwl-rebuild,
# que reconstruye desde el árbol fuente embebido usando /etc/dwl/config.h.

%:
	dh $@

override_dh_auto_build:
	cp config.def.h config.h
	dh_auto_build

override_dh_auto_install -- PREFIX=/usr:
	dh_auto_install -- PREFIX=/usr
	# Embebemos el árbol fuente completo (ya con el parche ipc aplicado
	# por fetch-source.sh) para que dwl-rebuild pueda recompilar in situ.
	mkdir -p debian/dwl-devuan/usr/src/dwl-devuan
	rsync -a --exclude=debian --exclude=.git ./ debian/dwl-devuan/usr/src/dwl-devuan/
