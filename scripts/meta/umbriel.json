{
  "script": "build-umbriel.sh",
  "needs_devuan_depot_repo": true,
  "base_apt_packages": [
    "dpkg-dev", "git", "curl", "jq", "ca-certificates",
    "meson", "g++", "just", "pkg-config",
    "libwayland-dev", "wayland-protocols",
    "libxkbcommon-dev", "libinput-dev", "libpixman-1-dev", "libdrm-dev",
    "libcairo2-dev", "libpango1.0-dev", "libtomlplusplus-dev",
    "nlohmann-json3-dev", "libjemalloc-dev", "hwdata", "wlroots0.20", "libegl-dev", "libgbm-dev", "libgles-dev", "libvulkan-dev", "liblcms2-dev", "libseat-dev", "libdisplay-info-dev", "libliftoff-dev", "libxcb-composite0-dev", "libxcb-ewmh-dev", "libxcb-icccm4-dev", "libxcb-res0-dev", "libxcb-xfixes0-dev", "libxcb-errors-dev", "cmake"
  ],
  "variants": [
    {
      "artifact_suffix": "default",
      "extra_apt_packages": [],
      "env": { "CXXFLAGS": "-O3 -march=x86-64-v3 -pipe -fno-plt", "CFLAGS": "-O3 -march=x86-64-v3 -pipe -fno-plt", "LDFLAGS": "-Wl,-O1,--sort-common,--as-needed,-z,relro,-z,now" }
    }
  ]
}
