{
  "script": "build-xwayland-satellite.sh",
  "needs_devuan_depot_repo": false,
  "base_apt_packages": [
    "build-essential", "pkg-config", "git", "dpkg-dev", "curl", "jq",
    "libxcb1-dev", "libxcb-render0-dev", "libxcb-shape0-dev", "libxcb-cursor-dev",
    "libxkbcommon-dev", "libwayland-dev", "clang", "libclang-dev"
  ],
  "variants": [
    {
      "artifact_suffix": "default",
      "extra_apt_packages": [],
      "env": { "CXXFLAGS": "-O3 -march=x86-64-v3 -pipe -fno-plt", "CFLAGS": "-O3 -march=x86-64-v3 -pipe -fno-plt", "LDFLAGS": "-Wl,-O1,--sort-common,--as-needed,-z,relro,-z,now" }
    }
  ]
}
