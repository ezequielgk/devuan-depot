{
  "script": "build-noctalia-greeter.sh",
  "needs_devuan_depot_repo": true,
  "base_apt_packages": [
    "file", "dpkg-dev", "git", "curl", "jq", "ca-certificates",
    "meson", "g++", "greetd", "dbus",
    "libwayland-dev", "wayland-protocols", "wlroots0.20",
    "libegl-dev", "libgles-dev",
    "libfreetype-dev", "libfontconfig-dev",
    "libcairo2-dev", "libpango1.0-dev", "libharfbuzz-dev",
    "libxkbcommon-dev", "libglib2.0-dev",
    "libtomlplusplus-dev", "nlohmann-json3-dev", "libstb-dev",
    "libwebp-dev", "librsvg2-dev", "libxml2-dev"
  ],
  "variants": [
    {
      "artifact_suffix": "default",
      "extra_apt_packages": [],
      "env": { "CXXFLAGS": "-O3 -march=x86-64-v3 -pipe -fno-plt", "LDFLAGS": "-Wl,-O1,--sort-common,--as-needed,-z,relro,-z,now" }
    }
  ]
}
