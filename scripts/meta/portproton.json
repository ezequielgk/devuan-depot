{
  "script": "build-portproton.sh",
  "needs_devuan_depot_repo": false,
  "base_apt_packages": ["curl", "jq", "dpkg-dev", "wget"],
  "variants": [
    {
      "artifact_suffix": "default",
      "extra_apt_packages": [],
      "env": { "CXXFLAGS": "-O3 -march=x86-64-v3 -pipe -fno-plt", "CFLAGS": "-O3 -march=x86-64-v3 -pipe -fno-plt", "LDFLAGS": "-Wl,-O1,--sort-common,--as-needed,-z,relro,-z,now" }
    }
  ]
}
